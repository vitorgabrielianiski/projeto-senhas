:root {
	--fundo-tela: #000411;
	--fundo-painel: #0A1128;
	--fundo-texto: #1C2541;
	--branco: #FFFFFF;
	--borda: #3A506B;
	--azul-neon: #00B4D8;
}

body {
	background-color: var(--fundo-tela);
	color: var(--branco);
	font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
	display: flex;
	justify-content: center;
	align-items: center;
	min-height: 100vh;
	margin: 0;
}

.container {
	width: 100%;
	max-width: 900px;
	padding: 20px;
}

.titulo-principal {
	font-size: 32px;
	margin-bottom: 24px;
}

/* Divide o layout na horizontal quando a tela for grande */
.painel-gerador {
	background-color: var(--fundo-painel);
	border-radius: 12px;
	padding: 40px;
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 40px;
	box-shadow: 0px 8px 24px rgba(0, 0, 0, 0.5);
}

.painel-esquerda {
	display: flex;
	flex-direction: column;
	justify-content: center;
}

.campo-resultado {
	display: flex;
	background-color: var(--fundo-texto);
	border: 2px solid var(--borda);
	border-radius: 8px;
	overflow: hidden;
}

#campo-senha {
	background: transparent;
	border: none;
	color: var(--azul-neon);
	font-size: 24px;
	font-weight: bold;
	padding: 16px;
	width: 100%;
	outline: none;
}

.botao-copiar {
	background-color: var(--borda);
	border: none;
	color: var(--branco);
	font-size: 24px;
	padding: 0 20px;
	cursor: pointer;
	transition: background 0.2s;
}

.botao-copiar:hover {
	background-color: var(--azul-neon);
}

.painel-direita {
	display: flex;
	flex-direction: column;
	gap: 24px;
}

.parametro-senha__titulo {
	font-size: 18px;
	margin: 0 0 12px 0;
}

.parametro-senha-botoes {
	display: flex;
	align-items: center;
}

.parametro-senha__botao {
	background-color: var(--fundo-texto);
	color: var(--branco);
	border: 2px solid var(--borda);
	padding: 12px 20px;
	font-size: 20px;
	cursor: pointer;
	font-weight: bold;
}

.parametro-senha__botao:first-child { border-radius: 8px 0 0 8px; }
.parametro-senha__botao:last-child { border-radius: 0 8px 8px 0; }

.parametro-senha__texto {
	background-color: var(--fundo-texto);
	padding: 12px 24px;
	border-top: 2px solid var(--borda);
	border-bottom: 2px solid var(--borda);
	margin: 0;
	font-size: 20px;
	font-weight: bold;
	min-width: 40px;
	text-align: center;
}

.parametro-senha-checkbox {
	display: flex;
	align-items: center;
	gap: 12px;
	margin-bottom: 8px;
}

.checkbox {
	width: 22px;
	height: 22px;
	cursor: pointer;
}

label {
	font-size: 18px;
	cursor: pointer;
}

/* Sistema Visual da Barra de Força */
.barra-recipiente {
	position: relative;
	width: 100%;
	height: 12px;
	margin-bottom: 8px;
}

.barra {
	background-color: var(--fundo-texto);
	height: 100%;
	width: 100%;
	border-radius: 6px;
	position: absolute;
}

.forca {
	height: 100%;
	position: absolute;
	border-radius: 6px;
	width: 0%;
	transition: width 0.3s ease, background-color 0.3s ease;
}

/* Classes injetadas via JS dinamicamente */
.fraca { width: 33%; background-color: #E71B32; }
.media { width: 66%; background-color: #FAF408; }
.forte { width: 100%; background-color: #00FF85; }

.parametro-senha-textos {
	display: flex;
	justify-content: space-between;
	font-size: 14px;
	color: #888;
}

.entropia {
	font-size: 14px;
	color: #a0a0a0;
	line-height: 1.4;
}

/* Responsividade para telas menores (Celular) */
@media (max-width: 768px) {
	.painel-gerador {
    	grid-template-columns: 1fr;
	}
}
